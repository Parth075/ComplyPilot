# ====================================================================
# ComplyPilot Environment Variables Example
# Duplicate this file to .env for local development
# NEVER commit real secret keys to source control
# ====================================================================

# --------------------------------------------------------------------
# Frontend Client Configuration (Vite / Browser exposed)
# --------------------------------------------------------------------
# Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon / Public Key (safe to expose in client bundle)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --------------------------------------------------------------------
# Server-Side Configuration (Supabase Edge Functions / Backend only)
# Set these secrets in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# --------------------------------------------------------------------
# 100% Free AI Tier: Google Gemini API Key (Get free at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# (Optional Paid Alternative) Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Supabase Service Role Key (NEVER expose to client, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Resend API Key for Compliance Deadline Reminders Edge Function (Free tier available at resend.com)
RESEND_API_KEY=your-resend-api-key-here

# Verified sender email address configured in Resend
RESEND_FROM_EMAIL=onboarding@yourdomain.com

# Base URL of the deployed application (used in reminder email links)
APP_BASE_URL=https://complypilot.vercel.app
